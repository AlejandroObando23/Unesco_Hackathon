# Backend Environment Variables — Copy to .env and fill in your values

# Supabase PostgreSQL connection string (from Supabase Dashboard > Settings > Database > Connection String > URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# CORS origin for the frontend dev server
FRONTEND_ORIGIN="http://localhost:5173"
