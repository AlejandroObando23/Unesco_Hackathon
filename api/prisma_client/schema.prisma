datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-py"
  interface     = "asyncio"
  output        = "../../api/prisma_client"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model Publication {
  id              Int      @id @default(autoincrement())
  text_content    String
  text_content_en String
  media_url       String?
  is_real         Boolean
  mil_tip         String
  mil_tip_en      String
  category        String?
  author_name     String?
  author_handle   String?
  likes_count     Int      @default(0)
  created_at      DateTime @default(now())
}

model LeaderboardEntry {
  id           Int      @id @default(autoincrement())
  player_name  String
  score        Int
  correct      Int
  wrong        Int
  omitted      Int
  accuracy_pct Float
  duration_s   Int
  created_at   DateTime @default(now())
}
